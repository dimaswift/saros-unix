{
  "name": "saros-eclipse",
  "version": "0.1.0",
  "description": "Solar and lunar eclipse lookup from NASA's full Saros catalog (Saros 1–180)",
  "keywords": ["astronomy", "eclipse", "solar", "lunar", "saros"],
  "license": "MIT",
  "author": "dimaswift",
  "repository": {
    "type": "git",
    "url": "https://github.com/dimaswift/saros-unix"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist",
    "data"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "vitest": "^1.0.0"
  }
}
